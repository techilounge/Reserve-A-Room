# Reserve-A-Room — environment variables
# Copy to .env.local for local development. NEVER commit real values (this repo is public).
# Variables prefixed NEXT_PUBLIC_ are sent to the browser — never put secrets in them.

# --- Application -------------------------------------------------------------
# Absolute base URL used for links in emails and metadata. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ----------------------------------------------------------------
# Project URL and publishable (anon) key — safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key — SERVER ONLY. Bypasses RLS. Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ----------------------------------------------------------
# Leave RESEND_API_KEY empty in local development: delivery is skipped and recorded as
# "Not sent" without logging private messages or links. In production it is a failure.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Reserve-A-Room <reservations@your-verified-domain>"
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# --- First Super Admin bootstrap (used only by `npm run bootstrap:super-admin`) --
INITIAL_SUPER_ADMIN_EMAIL=
# Optional display name for that person (defaults to the part of the email before @).
INITIAL_SUPER_ADMIN_NAME=

# --- Guest reservation links -------------------------------------------------
# Random secret (32+ chars). Guest management links are derived from it, so changing it
# invalidates every link already emailed. SERVER ONLY. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUEST_LINK_SECRET=

# --- Abuse protection --------------------------------------------------------
# Random secret (32+ chars) used to HMAC IP addresses/emails for rate limiting. SERVER ONLY.
RATE_LIMIT_SECRET=

# Optional only for local development and previews; production requires both keys.
# A partial configuration fails the build and public submissions fail closed.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Scheduled jobs ----------------------------------------------------------
# Protects both daily cron routes (email sweep and recurrence materializer; Vercel Cron
# sends it as a Bearer token automatically). Random 32+ chars. SERVER ONLY.
CRON_SECRET=
